@echo off
chcp 65001 >nul
echo ================================================================================
echo   DEPLOY SCRIPT - React + Nginx
echo   Запуск деплоя на сервер
echo ================================================================================
echo.

REM Проверка наличия Python
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Python не найден! Установите Python 3.x
    pause
    exit /b 1
)

echo [OK] Python найден
echo.

REM Запуск скрипта деплоя
echo Запуск deploy_full.py...
echo.
python deploy_full.py

if %errorlevel% equ 0 (
    echo.
    echo ================================================================================
    echo   ДЕПЛОЙ ЗАВЕРШЁН УСПЕШНО!
    echo ================================================================================
) else (
    echo.
    echo ================================================================================
    echo   [ERROR] ДЕПЛОЙ ЗАВЕРШИЛСЯ С ОШИБКОЙ!
    echo ================================================================================
)

echo.
pause
